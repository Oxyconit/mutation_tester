/tmp/

# Generated mutation reports (root and examples)
mutation_reports/
examples/mutation_reports/

# In-place backup written next to the source during a serial run (E03S08);
# recovered/removed by a clean run, so it must never be committed.
*.mutation_backup

# rspec failure tracking
.rspec_status

# Cross-version matrix alternate bundles (E04S23): each CI job re-resolves its
# own lock from the gemfiles/*.gemfile, so a committed lock must never pin them.
gemfiles/*.lock

# Development scratch artifacts
output.txt
mutator_flaws.rb
safety_check.rb
parallel_prototype.rb

